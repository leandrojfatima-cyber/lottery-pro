rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para perfil do usuário
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Apostas do usuário
      match /bets/{betId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Conferências do usuário
      match /conferences/{confId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Resultados públicos de concursos
    match /lottery_results/{concursoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
